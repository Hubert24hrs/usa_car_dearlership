# ─────────────────────────────────────────────────────────────────────────────
# Prestige Auto Group — environment variables
# Copy to `.env` for local development. NEVER commit real secrets.
# Everything except DATABASE_URL and AUTH_SECRET is optional: features
# degrade gracefully (e.g. emails are logged to the console without Resend).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). Used for canonical URLs, sitemap, emails.
# Production (once the domain is live): https://prestigeautosgroup.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Local default matches `npm run db` (embedded) and docker-compose.
# Production: managed Postgres (Neon / Supabase / Prisma Postgres free tiers).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dealership"
# DATABASE_POOL_MAX="10"

# Local embedded Postgres (scripts/db.mjs) — only used by `npm run db`.
LOCAL_PG_PORT="5433"
LOCAL_PG_USER="postgres"
LOCAL_PG_PASSWORD="postgres"
LOCAL_PG_DATABASE="dealership"

# ── Auth (NextAuth / Auth.js v5) ─────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Set to "true" when self-hosting behind a proxy (Vercel sets this automatically).
# AUTH_TRUST_HOST="true"

# First admin user created by `npm run db:seed` (change the password after login).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-strong-password"

# ── Inventory ────────────────────────────────────────────────────────────────
# Demo vehicles (is_demo=true) are hidden when NODE_ENV=production unless this
# is "true". Keep "true" locally / on staging, remove for production.
SHOW_DEMO_INVENTORY="true"

# Number of demo vehicles `npm run db:seed` creates (default 1500, same fuel mix).
# SEED_VEHICLE_COUNT="1500"

# Bearer secret for POST /api/inventory/sync and the cron endpoints.
# Vercel Cron automatically sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET="replace-me-with-a-long-random-string"
# Optional separate secret for external feed pushes (falls back to CRON_SECRET).
# INVENTORY_SYNC_SECRET=""
# Credentials referenced by feed sources (Admin → Feeds → "auth env var").
# HOMENET_FEED_TOKEN=""

# Search driver: "postgres" (default, built-in full-text) or "meilisearch".
SEARCH_DRIVER="postgres"
# MEILISEARCH_HOST="http://127.0.0.1:7700"
# MEILISEARCH_API_KEY=""
# MEILISEARCH_INDEX="vehicles"

# ── Email (Resend — free tier) ───────────────────────────────────────────────
# Without RESEND_API_KEY emails are printed to the server console instead.
# RESEND_API_KEY=""
# After verifying the domain in Resend, e.g. "Prestige Auto Group <sales@prestigeautosgroup.com>".
EMAIL_FROM="Prestige Auto Group <no-reply@example.com>"
# Where new leads are delivered (comma-separated).
LEADS_NOTIFY_EMAIL="sales@example.com"

# ── Media storage ────────────────────────────────────────────────────────────
# "local" writes uploads to /public/uploads (dev only — read-only on Vercel),
# "cloudinary" or "s3" (any S3-compatible store, e.g. R2) for production.
STORAGE_DRIVER="local"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="inventory"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""          # public base URL for uploaded objects

# ── Rate limiting ────────────────────────────────────────────────────────────
# In-memory by default (fine for a single instance). For serverless/multi-
# instance production use Upstash Redis (free tier):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Trade-in VIN decoding ────────────────────────────────────────────────────
# "nhtsa" = free NHTSA vPIC API (no key). "none" disables lookups.
VIN_DECODER="nhtsa"
# Plate-to-VIN lookup requires a paid data provider — adapter stub only.
# PLATE_LOOKUP_PROVIDER=""

# ── Analytics (all optional; loaded only after consent) ──────────────────────
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_META_PIXEL_ID=""
# Vercel Analytics is enabled automatically on Vercel deployments.
